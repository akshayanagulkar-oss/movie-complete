<%- include('partials/header', { title: 'Edit Movie' }) %>

<main class="form-page">
  <div class="form-card">
    <div class="form-heading"><h1>Edit Movie</h1><a href="/moviepage">← Movie List</a></div>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form action="/edit/<%= movie._id %>" method="post" class="movie-form">
      <div class="form-grid">
        <label>Movie Name *<input name="name" value="<%= movie.name %>" required></label>
        <label>Release Year *<input name="releaseYear" type="number" value="<%= movie.releaseYear %>" required></label>
        <label>Production Company<input name="productionCompany" value="<%= movie.productionCompany %>"></label>
        <label>Genre *<input name="genre" value="<%= movie.genre %>" required></label>
        <label>Rating (0-5)<input name="rating" type="number" min="0" max="5" step="0.1" value="<%= movie.rating %>"></label>
        <label>Runtime (minutes)<input name="runtime" type="number" min="1" value="<%= movie.runtime %>"></label>
        <label>Director<input name="director" value="<%= movie.director %>"></label>
        <label>Poster path / URL<input name="poster" value="<%= movie.poster %>"></label>
      </div>
      <label>Description<textarea name="description" rows="5"><%= movie.description %></textarea></label>
      <button class="btn" type="submit">Update Movie</button>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
